// SQLite schema for the single-owner local 360Vision studio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Automatic workspace owner. No credentials or sessions are stored.
model User {
  id        String   @id @default(cuid())
  name      String?
  image     String?
  username  String?  @unique
  bio       String?
  website   String?
  createdAt DateTime @default(now())
  tours     Tour[]
}

model Tour {
  id          String    @id @default(cuid())
  ownerId     String
  slug        String
  title       String
  description String
  visibility  String    @default("draft")
  coverUrl    String?
  data        String
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, slug])
  @@index([visibility, publishedAt])
}
