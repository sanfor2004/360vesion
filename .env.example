# Copy to .env (Prisma + Next read it) and fill in.

# ---- Public site URL ----
# Canonical origin, used for Open Graph image tags, the sitemap, robots.txt and
# server-side share/embed snippets. Set this in production, e.g.
#   NEXT_PUBLIC_SITE_URL="https://360vision.app"
# Leave blank for local dev (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=""

# ---- Database (Prisma · MySQL) ----
# MySQL connection string. URL-encode any special characters in the password
# (e.g. } ; $ → %7D %3B %24). Sync the schema with: npm run db:push
#   DATABASE_URL="mysql://user:pass@host:3306/dbname?connection_limit=5"
DATABASE_URL=""

# ---- Auth.js / NextAuth v5 ----
# Required. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (optional). Redirect URI: <origin>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
