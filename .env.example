# Copy to .env. No credentials or account configuration is required.

# ---- Public site URL ----
# Canonical origin, used for Open Graph image tags, the sitemap, robots.txt and
# server-side share/embed snippets. Set this in production.
#   NEXT_PUBLIC_SITE_URL="https://example.com"
# Leave blank for local dev (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=""

# ---- Database (Prisma · SQLite) ----
# Local SQLite database file. Prisma resolves this path relative to prisma/schema.prisma.
# Sync the schema with: npm run db:push
DATABASE_URL="file:./dev.db"
